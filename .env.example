# Render service (scripts/render-server.mjs, scripts/render-job.mjs)
# Read directly by this repo's Node scripts.
RENDER_SERVER_HOST=172.17.0.1
RENDER_SERVER_PORT=8091
RENDER_SERVER_TOKEN=your_render_server_token

VIDEO_JOBS_PATH=./public/jobs
OUTPUT_PATH=./out/jobs
REMOTION_PROJECT_PATH=
REMOTION_STATIC_BASE=/public
# Only needed in sandboxed environments without their own Chrome download
REMOTION_BROWSER_EXECUTABLE=

# n8n workflow (workflow/content-production-workflow.json)
# These are NOT read by this repo's code. RENDER_SERVER_TOKEN and
# ELEVENLABS_VOICE_ID are consumed by n8n itself via {{ $env.VAR }}
# expressions inside the workflow, so set them wherever n8n runs (its own
# .env / docker-compose environment / systemd unit).
# GROQ_API_KEY, ELEVENLABS_API_KEY, and the RapidAPI key used for the
# content-discovery source are configured as n8n credentials through the
# n8n UI, not as plain environment variables, and never appear in this repo.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
